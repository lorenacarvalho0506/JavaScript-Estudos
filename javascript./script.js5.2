//ordenação de array mais completa, com maior uso de loops e entrada de usuário

let entrada = prompt(`digite os valores que serão ordenados separados por espaço: `);
let valores = entrada.split(` `);
let array = [];
for (let k = 0; k < valores.length; k++) {
    array[k]= Number(valores[k]);
}
let original = [];
for (let o = 0; o < valores.length; o++) {
    original[o]= Number(valores[o]);
}
function bubbleSort(array) {
    for (let i = 0; i < array.length - 1; i++) {
        for (let j = 0; j < array.length - 1; j++ ) {
            if (array[j] > array[j + 1]) {
                let temp = array[j + 1];
                array[j + 1] = array[j];
                array[j] = temp;
            }
        }
    }
}
bubbleSort(array);
for(let n = 0; n < array.length; n++){
    console.log(array[n]);
}
console.log();
for(let n = 0; n < original.length; n++){
    console.log(original[n]);
}
